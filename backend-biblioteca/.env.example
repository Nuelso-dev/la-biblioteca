# Puerto de ejecución del servidor Express API (Nativo: 3001)
PORT=3001

# Cadena de conexión PostgreSQL (Supabase Connection Pooler en modo Transaction - Puerto 6543)
# En Supabase Dashboard: Project Settings > Database > Connection string > URI > marcar "Use connection pooling" (Mode: Transaction)
# Compatible con IPv4/IPv6 y optimizado para APIs con múltiples conexiones simultáneas
DATABASE_URL=postgresql://postgres.TU_ID_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Credenciales de Supabase para validación de tokens de autenticación
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICO

# Orígenes web permitidos para CORS (Frontend en puerto 3000)
CORS_ORIGIN=http://localhost:3000
